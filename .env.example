# Prisma Connection Strings (for development)
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}" # note: interpolation requires dotenv-expand; use a literal string otherwise
DATABASE_URL_DIRECT="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}" # note: interpolation requires dotenv-expand; use a literal string otherwise

# Cloudinary Configuration
