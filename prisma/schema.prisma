generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}


model User {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique() @default(uuid()) @db.Uuid
  name        String?
  email       String   @unique()
  password    String
  phonenumber String?
  role        UserRole
  is_verified Boolean  @default(false)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenants     Tenant?
  otps        OTP[]  

  @@map("users")
}

model OTP {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique() @default(uuid()) @db.Uuid
  user_id    Int
  otp        String
  is_used    Boolean  @default(false)
  expired_at DateTime
  type       OTPType  @default(register)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User     @relation(fields: [user_id], references: [id])

  @@map("otps")
}

enum UserRole {
  superadmin
  admin
  user
}

enum OTPType {
  register
  update_email
}

model Certificate {
  id                        Int       @id @default(autoincrement())
  uuid                      String    @unique() @default(uuid()) @db.Uuid
  product_id                Int
  description               String?
  bpom_number               String?
  pirt_number               String?
  license_number            String?
  halal_id                  Int?

  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  product       Product     @relation(fields: [product_id], references: [id])
  halal         Halal?      @relation(fields: [halal_id], references: [id])

  @@map("certificates")
}

model Halal {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @default(uuid()) @db.Uuid
  number          String
  authority       String?
  valid_until     DateTime?

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  certificates    Certificate[]

  @@map("halals")
}

model Tenant {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique() @default(uuid()) @db.Uuid
  name          String
  district      String?
  province      String?
  description   String?
  address       String?
  email         String?
  phonenumber   String?
  status        String
  user_id       Int       @unique()

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  products      Product[]
  user          User      @relation(fields: [user_id], references: [id])

  @@map("tenants")
}

model Product {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @default(uuid()) @db.Uuid
  name            String
  price           Float?
  brand           String?
  description     String?
  tenant_id       Int
  type            ProductCategory
  license_code    String?   @unique()

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  tenant          Tenant @relation(fields: [tenant_id], references: [id])
  certificates    Certificate[]
  nutrition_info  NutritionInfo?

  images          ProductImage[]

  @@map("products")
}

model ProductImage {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique() @default(uuid()) @db.Uuid
  product_id  Int
  url         String

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  product     Product   @relation(fields: [product_id], references: [id])

  @@map("product_images")
}

model NutritionInfo {
  id              Int       @id @default(autoincrement())
  product_id      Int       @unique()
  servings        Float?
  energy          Float?
  fat             Float?
  saturated_fat   Float?
  protein         Float?
  carbo           Float?
  sugar           Float?
  natrium         Float?

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  product         Product   @relation(fields: [product_id], references: [id])

  @@map("nutrition_infos")
}

enum ProductCategory {
  fnb
  cosmetic
  pharmaceutical
}


model FinancialRecord {
  id                  String              @id @default(cuid())

  product_name        String
  transaction_type    TransactionType
  amount              Int

  transaction_status  TransactionStatus   @default(completed)
  transaction_date    DateTime            @default(now())

  notes               String?

  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  @@map("financial_records")
}

enum TransactionType {
  income
  expense
}

enum TransactionStatus {
  completed
  pending
}
