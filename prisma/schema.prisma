generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Certificate {
  id                  Int       @id @default(autoincrement())
  uuid                String    @unique() @db.Uuid
  enterprise_id       Int
  product_id          Int
  description         String?
  bpom_type           String?     
  bpom_number         String?
  pirt_number         String?
  lisence_number      String?
  is_halal            Boolean?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enterprise    Enterprise @relation(fields: [enterprise_id], references: [id])
  product       Product    @relation(fields: [product_id], references: [id])
  @@map("certificates")
}

model Enterprise {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique() @db.Uuid
  name          String
  description   String?
  address       String?
  status        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  certificates  Certificate[]
  products      Product[]

  @@map("enterprises")
}

model Product {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @db.Uuid
  name            String
  image_url       String?
  price           Float?
  brand           String?
  description     String?
  enterprise_id   Int
  type            ProductType
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enterprise      Enterprise @relation(fields: [enterprise_id], references: [id])
  certificates    Certificate[]

  @@map("products")
}

enum ProductType {
  food
  beverage
  cosmetic
  pharmaceutical
}