generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}


model User {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique() @default(uuid()) @db.Uuid
  name        String?
  email       String   @unique()
  password    String
  phonenumber String?
  role        UserRole


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants     Tenant?

  @@map("users")
}

enum UserRole {
  superadmin
  admin
  user
}

model Certificate {
  id                        Int       @id @default(autoincrement())
  uuid                      String    @unique() @default(uuid()) @db.Uuid
  product_id                Int
  description               String?
  bpom_number               String?
  pirt_number               String?
  license_number            String?
  halal_id                  Int?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  product       Product     @relation(fields: [product_id], references: [id])
  halal         Halal?      @relation(fields: [halal_id], references: [id])

  @@map("certificates")
}

model Halal {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @default(uuid()) @db.Uuid
  number          String
  authority       String?
  valid_until     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  certificates    Certificate[]

  @@map("halals")
}

model Tenant {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique() @default(uuid()) @db.Uuid
  name          String
  district      String?
  province      String?
  description   String?
  address       String?
  email         String?
  phonenumber   String?
  status        String
  user_id       Int       @unique()

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
  user          User      @relation(fields: [user_id], references: [id])

  @@map("tenants")
}

model Product {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @default(uuid()) @db.Uuid
  name            String
  price           Float?
  brand           String?
  description     String?
  tenant_id       Int
  type            ProductCategory
  license_code    String?   @unique()

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant @relation(fields: [tenant_id], references: [id])
  certificates    Certificate[]
  nutrition_info  NutritionInfo?

  images          ProductImage[]

  @@map("products")
}

model ProductImage {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique() @default(uuid()) @db.Uuid
  product_id  Int
  url         String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [product_id], references: [id])

  @@map("product_images")
}

model NutritionInfo {
  id              Int       @id @default(autoincrement())
  product_id      Int       @unique()
  servings        Float?
  energy          Float?
  fat             Float?
  saturated_fat   Float?
  protein         Float?
  carbo           Float?
  sugar           Float?
  natrium         Float?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product         Product   @relation(fields: [product_id], references: [id])

  @@map("nutrition_infos")
}

enum ProductCategory {
  fnb
  cosmetic
  pharmaceutical
}


model FinancialRecord {
  id              String                @id @default(cuid())
  namaProduk      String
  tipe            TransactionType
  jumlah          Float
  status          TransactionStatus     @default(COMPLETED)
  tanggal         DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

enum TransactionType {
  MASUK
  KELUAR
}

enum TransactionStatus {
  COMPLETED
  PENDING
}
