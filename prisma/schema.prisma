generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}


model User {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique() @db.Uuid
  name        String?
  email       String   @unique()
  password    String
  phonenumber String?
  role        UserRole


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enterprises Enterprise[]

  @@map("users")
}

enum UserRole {
  superadmin
  admin
  user
}

model Certificate {
  id                        Int       @id @default(autoincrement())
  uuid                      String    @unique() @db.Uuid
  product_id                Int
  description               String?    
  bpom_number               String?
  pirt_number               String?
  license_number            String?
  halal_id                  Int?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  product       Product     @relation(fields: [product_id], references: [id])
  halal         Halal?      @relation(fields: [halal_id], references: [id])

  @@map("certificates")
}

model Halal {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @db.Uuid
  number          String
  authority       String?
  valid_until     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  certificates    Certificate[]

  @@map("halals")
}

model Enterprise {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique() @db.Uuid
  name          String
  district      String?
  province      String?
  description   String?
  address       String?
  email         String?
  phonenumber   String?
  status        String
  user_id       Int
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
  user          User      @relation(fields: [user_id], references: [id])

  @@map("enterprises")
}

model Product {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @db.Uuid
  name            String
  image_url       String?
  price           Float?
  brand           String?
  description     String?
  enterprise_id   Int
  type            ProductCategory
  license_code    String?   @unique()
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enterprise      Enterprise @relation(fields: [enterprise_id], references: [id])
  certificates    Certificate[]
  nutrition_info  NutritionInfo?

  @@map("products")
}

model NutritionInfo {
  id              Int       @id @default(autoincrement())
  product_id      Int       @unique()
  servings        Float?
  energy          Float?
  fat             Float?
  saturated_fat   Float?
  protein         Float?
  carbo           Float?
  sugar           Float?
  natrium         Float?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product         Product   @relation(fields: [product_id], references: [id])
  
  @@map("nutrition_infos")
}

enum ProductCategory {
  fnb
  cosmetic
  pharmaceutical
}