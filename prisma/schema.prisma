generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Certificate {
  id                  Int       @id @default(autoincrement())
  uuid                String    @unique() @db.Uuid
  enterprise_id       Int
  product_id          Int
  description         String?    
  bpom_number         String?
  pirt_number         String?
  lisence_number      String?
  halal_id            Int?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enterprise    Enterprise @relation(fields: [enterprise_id], references: [id])
  product       Product    @relation(fields: [product_id], references: [id])
  halal         Halal?     @relation(fields: [halal_id], references: [id])

  @@map("certificates")
}

model Halal {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @db.Uuid
  number          String
  authority       String?
  valid_until     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  certificates    Certificate[]

  @@map("halals")
}

model Enterprise {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique() @db.Uuid
  name          String
  phone         String?
  email         String?
  description   String?
  address       String?
  status        String
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  certificates  Certificate[]
  products      Product[]

  @@map("enterprises")
}

model Product {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @db.Uuid
  name            String
  image_url       String?
  price           Float?
  brand           String?
  description     String?
  enterprise_id   Int
  type            ProductCategory
  barcode         String?   @unique()
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enterprise      Enterprise @relation(fields: [enterprise_id], references: [id])
  certificates    Certificate[]
  nutrition_info  NutritionInfo?

  @@map("products")
}

model NutritionInfo{
  id              Int       @id @default(autoincrement())
  product_id      Int       @unique()
  servings        Float?
  energy          Float?
  fat             Float?
  saturated_fat   Float?
  protein         Float?
  carbo           Float?
  sugar           Float?
  natrium         Float?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product         Product   @relation(fields: [product_id], references: [id])
  
  @@map("nutrition_infos")
}

enum ProductCategory {
  fnb
  cosmetic
  pharmaceutical
}