generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  //directUrl = env("DATABASE_URL_DIRECT")
}


model User {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique() @default(uuid()) @db.Uuid
  name        String?
  email       String   @unique()
  password    String
  phonenumber String?
  role        UserRole
  is_verified Boolean  @default(false)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenants     Tenant?
  otps        OTP[]  

  @@map("users")
}

model OTP {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique() @default(uuid()) @db.Uuid
  user_id    Int
  otp        String
  is_used    Boolean  @default(false)
  expired_at DateTime
  type       OTPType  @default(register)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User     @relation(fields: [user_id], references: [id])

  @@map("otps")
}

enum UserRole {
  superadmin
  admin
  user
}

enum OTPType {
  register
  update_email
}

model Tenant {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique() @default(uuid()) @db.Uuid
  user_id         Int           @unique()

  name            String?
  trade_name      String?
  business_field  String?
  npwp            String?
  description     String?
  address         String?
  city            String?
  postal_code     String?
  province        String?
  latitude        Float?
  longitude       Float?
  email           String?
  phonenumber     String?
  website         String?
  logo_url        String?
  logo_public_id  String?
  place_url       String?
  place_public_id String?
  year            Int?
  status          TenantStatus  @default(pending)

  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  user            User          @relation(fields: [user_id], references: [id])
  products        Product[]
  financial_records FinancialRecord[]

  @@map("tenants")
}

enum TenantStatus {
  active
  inactive
  pending
}

model Certificate {
  id                    Int             @id @default(autoincrement())
  uuid                  String          @unique() @default(uuid()) @db.Uuid
  product_id            Int
  type                  CertificateType
  number                String?
  registered_at         DateTime?
  valid_until           DateTime?
  certificate_url       String?
  certificate_public_id String?
  lab_name              String?

  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  deleted_at            DateTime?

  product               Product         @relation(fields: [product_id], references: [id])

  @@unique([product_id, type])
  @@map("certificates")
}

enum CertificateType {
  bpom
  pirt
  halal
  coa
}

model Product {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique() @default(uuid()) @db.Uuid
  name            String
  price           Float?
  brand           String?
  description     String?
  tenant_id       Int
  type            ProductCategory
  weight          Float?
  weight_unit     WeightUnits?
  qr_code_url     String?
  barcode_url     String?
  license_code    String?   @unique()

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  tenant          Tenant @relation(fields: [tenant_id], references: [id])
  certificates    Certificate[]
  nutrition_info  NutritionInfo?
  serving         ProductServing?

  images          ProductImage[]
  financial_records FinancialRecord[]

  @@map("products")
}

enum ProductCategory {
  fnb
  cosmetic
  pharmaceutical
}

enum WeightUnits {
  g
  kg
  ml
  l
  pcs
  lusin
}

model ProductImage {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique() @default(uuid()) @db.Uuid
  product_id  Int
  url         String
  public_id   String

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  product     Product   @relation(fields: [product_id], references: [id])

  @@map("product_images")
}

model NutritionInfo {
  id              Int       @id @default(autoincrement())
  product_id      Int       @unique()
  servings        Float?
  serving_pkgs    Float?
  energy          Float?
  fat             Float?
  saturated_fat   Float?
  protein         Float?
  carbo           Float?
  sugar           Float?
  natrium         Float?
  composition     String?
  allergens       String[]

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  product         Product   @relation(fields: [product_id], references: [id])

  @@map("nutrition_infos")
}

model ProductServing {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique() @default(uuid()) @db.Uuid
  product_id        Int       @unique()
  serving_info      String?
  serving_portion   String?
  storage_info      String?
  video_url         String?

  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  product           Product   @relation(fields: [product_id], references: [id])
  images            ProductServingImage[]

  @@map("product_servings")
}

model ProductServingImage {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique() @default(uuid()) @db.Uuid
  serving_id  Int
  url         String
  public_id   String

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  serving     ProductServing @relation(fields: [serving_id], references: [id])

  @@map("product_serving_images")
}


model FinancialRecord {
  id                Int          @id @default(autoincrement())
  cuid              String       @unique @default(cuid())
  tenant_id         Int
  product_id        Int?
  product_name      String
  transaction_type  TransactionType
  amount            Int
  transaction_date  DateTime
  notes             String?

  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  tenant            Tenant          @relation(fields: [tenant_id], references: [id])
  product           Product?        @relation(fields: [product_id], references: [id])

  @@map("financial_records")
}

enum TransactionType {
  income
  expense
}

enum TransactionStatus {
  completed
  pending
}
