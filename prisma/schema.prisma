generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Certificate {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique() @db.Uuid
  enterprise_id Int
  description   String?
  permissions   String
  is_halal      Boolean?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enterprise    Enterprise @relation(fields: [enterprise_id], references: [id])
  @@map("certificates")
}

model Enterprise {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique() @db.Uuid
  name          String
  description   String?
  address       String?
  status        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  certificates  Certificate[]
  @@map("enterprises")
}